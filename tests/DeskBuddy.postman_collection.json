{
  "info": {
    "name": "DeskBuddy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:5294" },
    { "key": "authToken",  "value": "" },
    { "key": "deviceId",   "value": "" },
    { "key": "eventId",    "value": "" }
  ],
  "item": [

    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]}
          }]
        }
      ]
    },

    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/login – valid credentials",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has token', () => pm.expect(pm.response.json().token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('authToken', pm.response.json().token);"
            ]}
          }]
        },
        {
          "name": "POST /api/auth/login – invalid password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]}
          }]
        },
        {
          "name": "GET /api/auth/me – with token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Username is admin', () => pm.expect(pm.response.json().username).to.eql('admin'));"
            ]}
          }]
        }
      ]
    },

    {
      "name": "Devices",
      "item": [
        {
          "name": "GET /api/devices – no token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/devices"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]}
          }]
        },
        {
          "name": "POST /api/devices – create device",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/devices",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Desk-Device-01\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Has id', () => pm.expect(pm.response.json().id).to.be.a('number'));",
              "pm.collectionVariables.set('deviceId', pm.response.json().id);"
            ]}
          }]
        },
        {
          "name": "GET /api/devices – get all",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/devices",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]}
          }]
        },
        {
          "name": "GET /api/devices/{id} – get by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/devices/{{deviceId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('deviceId')));"
            ]}
          }]
        },
        {
          "name": "GET /api/devices/{id}/status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/devices/{{deviceId}}/status",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has isOnline', () => pm.expect(pm.response.json()).to.have.property('isOnline'));",
              "pm.test('Has batteryLevel', () => pm.expect(pm.response.json()).to.have.property('batteryLevel'));"
            ]}
          }]
        },
        {
          "name": "POST /api/devices/{id}/heartbeat – with API key",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/devices/{{deviceId}}/heartbeat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Api-Key",    "value": "deskbuddy-device-key-2024" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"batteryLevel\": 100,\n  \"mood\": \"happy\",\n  \"mode\": \"face\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has message', () => pm.expect(pm.response.json().message).to.be.a('string'));"
            ]}
          }]
        },
        {
          "name": "POST /api/devices/{id}/heartbeat – no API key",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/devices/{{deviceId}}/heartbeat",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"batteryLevel\": 100,\n  \"mood\": \"happy\",\n  \"mode\": \"face\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]}
          }]
        },
        {
          "name": "PUT /api/devices/{id} – update device",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/devices/{{deviceId}}",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Desk-Device-01-Updated\",\n  \"isOnline\": true,\n  \"batteryLevel\": 80,\n  \"mood\": \"happy\",\n  \"mode\": \"face\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));"
            ]}
          }]
        },
        {
          "name": "DELETE /api/devices/{id} – delete device",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/devices/{{deviceId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));"
            ]}
          }]
        },
        {
          "name": "GET /api/devices/{id} – 404 after delete",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/devices/{{deviceId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]}
          }]
        },
        {
          "name": "POST /api/devices – validation: empty name",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/devices",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Has errors', () => pm.expect(pm.response.json().errors).to.exist);"
            ]}
          }]
        },
        {
          "name": "PUT /api/devices – validation: battery out of range",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/devices/1",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test\",\n  \"isOnline\": true,\n  \"batteryLevel\": 150,\n  \"mood\": \"neutral\",\n  \"mode\": \"face\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]}
          }]
        }
      ]
    },

    {
      "name": "CalendarEvents",
      "item": [
        {
          "name": "POST /api/calendarevents – create event",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/calendarevents",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Team Meeting\",\n  \"startTime\": \"2026-06-10T09:00:00\",\n  \"endTime\": \"2026-06-10T10:00:00\",\n  \"location\": \"Room 1\",\n  \"description\": \"Weekly sync\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Has id', () => pm.expect(pm.response.json().id).to.be.a('number'));",
              "pm.collectionVariables.set('eventId', pm.response.json().id);"
            ]}
          }]
        },
        {
          "name": "GET /api/calendarevents – get all",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/calendarevents",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]}
          }]
        },
        {
          "name": "GET /api/calendarevents/{id} – get by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/calendarevents/{{eventId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct title', () => pm.expect(pm.response.json().title).to.eql('Team Meeting'));"
            ]}
          }]
        },
        {
          "name": "PUT /api/calendarevents/{id} – update event",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/calendarevents/{{eventId}}",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Team Meeting Updated\",\n  \"startTime\": \"2026-06-10T09:00:00\",\n  \"endTime\": \"2026-06-10T11:00:00\",\n  \"location\": \"Room 2\",\n  \"description\": \"Updated sync\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));"
            ]}
          }]
        },
        {
          "name": "DELETE /api/calendarevents/{id} – delete event",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/calendarevents/{{eventId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));"
            ]}
          }]
        },
        {
          "name": "POST /api/calendarevents – validation: missing title",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/calendarevents",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"startTime\": \"2026-06-10T09:00:00\",\n  \"endTime\": \"2026-06-10T10:00:00\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Has errors', () => pm.expect(pm.response.json().errors).to.exist);"
            ]}
          }]
        }
      ]
    },

    {
      "name": "GoogleCalendar",
      "item": [
        {
          "name": "POST /api/googlecalendar/sync",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/googlecalendar/sync",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "GET /api/googlecalendar/events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/googlecalendar/events",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]}
          }]
        }
      ]
    },

    {
      "name": "NowNext",
      "item": [
        {
          "name": "GET /api/nownext – with API key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/nownext",
            "header": [{ "key": "X-Api-Key", "value": "deskbuddy-device-key-2024" }]
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has todayEventCount', () => pm.expect(pm.response.json()).to.have.property('todayEventCount'));"
            ]}
          }]
        },
        {
          "name": "GET /api/nownext – no API key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/nownext"
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]}
          }]
        }
      ]
    }

  ]
}
